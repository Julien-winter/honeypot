# Copy to .env and fill in. Never commit .env (contains secrets).

# REQUIRED: Discord bot token (Developer Portal > Bot > Token).
DISCORD_TOKEN=

# Database. Defaults to a local SQLite file (recommended on Pterodactyl).
# Examples: sqlite://honeypot.sqlite | postgres://user:pass@host:5432/db
# NOTE: MySQL/MariaDB is NOT supported by the queries (migrations exist,
# but runtime SQL uses SQLite/Postgres-only syntax).
#DATABASE_URL=sqlite://honeypot.sqlite

# Optional: only needed for sharded/websocket proxy mode.
#REDIS_URL=

# Set to 1 if Message Content Intent is enabled in the Developer Portal.
# Enables the forward-message and ensure-msg-delete experiments, and is
# required for the security anti-phishing module to read message links.
#HAS_MESSAGE_INTENT=

# In sharded mode bot/webhook messages are dropped early by default.
# Set to 1 to let anti-phishing scan messages from other bots as well.
#SECURITY_BOT_MESSAGES=0

# Audit-log poller (security event log & bot quarantine).
# Set SECURITY_POLLER=0 to disable it entirely.
#SECURITY_POLLER=1
# Seconds between audit-log polls (default 20)
#SECURITY_POLL_SEC=20
# Approx. seconds per server for a full audit-log cycle (default 120)
#SECURITY_CYCLE_SEC=120

# Stats dashboard + /health port. Falls back to SERVER_PORT (Pterodactyl
# allocation), then PORT, then 3000.
#STATS_PORT=

# Mod dashboard login (https://your-host/dashboard). Requires BOTH:
# - Client secret (Developer Portal > General Information)
# - Public base URL (https recommended; plain http may work too).
# Also register PUBLIC_URL + "/api/auth/callback" under OAuth2 > Redirects.
#DISCORD_CLIENT_SECRET=
#PUBLIC_URL=

# Bot owner IDs (comma-separated) for full dashboard access + crown badge.
# Also the people (besides the server owner) who may approve restores /
# anti-nuke responses. Default covers the main bot owners.
#OWNER_IDS=

# Anti-Nuke: comma-separated role ids. Members holding one of these roles may
# delete channels/roles freely - their deletions never trigger the anti-nuke.
#ANTI_NUKE_TRUSTED_ROLES=

# Anti-Nuke snapshots: how many messages per text channel are captured and
# re-posted on restore (0-50, default 30).
#BACKUP_MESSAGES=30

# Optional link overrides (defaults point to this instance's own pages).
#INVITE_URL=
#DOCS_URL=
#SITE_URL=
#STATS_PAGE_URL=
#DASHBOARD_URL=
# Support server + repo links used in the welcome message.
#SUPPORT_URL=
#GITHUB_URL=

# Litecoin address shown in the stats page footer for hosting donations.
#DONATE_LTC=

# Custom honeypot emoji ID (from a server the bot is in) for reactions/buttons.
#CUSTOM_EMOJI_ID=

# Recovery link shown in ban DMs (default: own docs #hacked-account section).
#RECOVERY_URL=

# Thumbnail image shown in bot messages (needs a public https URL to embed).
#THUMBNAIL_URL=

# Premium (BYOB): isolate encryption key for stored tokens (change once, keep secret).
#PREMIUM_SECRET=

# Discord server shown in the community card on the stats page (widget must
# be enabled: Server Settings > Widget). Falls back to the invite button URL.
#COMMUNITY_GUILD_ID=
